  "tagOwners": {
    "tag:dev": ["autogroup:admin"],
    "tag:personal": ["autogroup:admin"],
    "tag:phone": ["autogroup:admin"]
  },
  "grants": [
    { "src": ["tag:personal"], "dst": ["tag:dev"], "ip": ["*"] },
    { "src": ["tag:phone"], "dst": ["tag:dev"], "ip": ["tcp:80", "tcp:443", "tcp:1024-65535"] }
