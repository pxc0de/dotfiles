{
  "tagOwners": {
    "tag:headless": ["autogroup:admin"],
    "tag:main": ["autogroup:admin"],
    "tag:phone": ["autogroup:admin"]
  },
  "grants": [
    { "src": ["tag:main"], "dst": ["tag:headless"], "ip": ["*"] },
    { "src": ["tag:phone"], "dst": ["tag:headless"], "ip": ["tcp:80", "tcp:443", "tcp:1024-65535"] }
  ],
  "tests": [
    { "src": "tag:main", "accept": ["tag:headless:22", "tag:headless:443"] },
    { "src": "tag:phone", "accept": ["tag:headless:443", "tag:headless:3000"], "deny": ["tag:headless:22", "tag:main:443"] },
    { "src": "tag:headless", "deny": ["tag:main:22", "tag:main:443", "tag:phone:443"] }
  ]
}
